rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- HELPERS --
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    
    function getUserRole() {
      return getUserData(request.auth.uid).role;
    }
    
    function isSuperAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['emyr.arthuro@gmail.com'];
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && (
          isSuperAdmin()
          || request.auth.token.email in ['info@emyrarthuro.com']
        );
    }

    // Safety net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // USERS
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      // Un usuario no puede asignarse un rol elevado creando su propio perfil.
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role == 'student'
          || (isSuperAdmin() && request.resource.data.role == 'super_admin')
          || (isAdmin() && request.resource.data.role == 'admin')
        );
      
      allow update: if isAuthenticated() && (
        // Self-service profile edits cannot rewrite identity or role metadata.
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.uid == resource.data.uid) ||
        isSuperAdmin() ||
        (isAdmin() && resource.data.role == 'student' && request.resource.data.role == 'student')
      );
      
      allow delete: if isAdmin() && (
        (isSuperAdmin() && resource.data.email != 'emyr.arthuro@gmail.com' && request.auth.uid != userId) ||
        (isAdmin() && resource.data.role == 'student' && request.auth.uid != userId)
      );
    }
    
    // DIAGNOSTICS
    match /diagnostics/{docId} {
      allow get: if isAuthenticated() && (
        docId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin();
      
      allow create: if isAuthenticated() && docId == request.auth.uid;
      allow update: if isAuthenticated() && (
        docId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        docId == request.auth.uid
      );
    }
    
    // DIAGNOSTICS ARCHIVED
    match /diagnostics_archived/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // AUDIT LOG
    match /audit_log/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    
    // INVITATIONS
    match /invitations/{invitationId} {
      allow read, write: if isAdmin();
    }
    
    // ACTIVITY LOGS
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    
    // TAGS
    match /tags/{tagId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // CLASSES
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}
